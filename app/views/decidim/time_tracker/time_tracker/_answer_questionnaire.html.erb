<% if activity.answered_by? current_user %>
  <p class="time-tracker__timer-rule"><%= icon "check-line" %> <span><%= t("questionnaire.answered", scope: "decidim.time_tracker.time_tracker.activity") %></span></p>
<% else %>
  <%= link_to task_activity_form_path(task_id: activity.task, activity_id: activity, id: activity.questionnaire), class: "time-tracker__questionnaire-link" do %>
    <%= icon "chat-1-line" %> <%= t("questionnaire.respond", scope: "decidim.time_tracker.time_tracker.activity") %>
  <% end %>
<% end %>
