<div class="card--list__item time-tracker-activity-card time-tracker-request" data-activity-id="<%= activity.id %>">
  <div class="card--list__icon">
    <%= icon "checkbox-circle-line", class: "icon--small text-muted", role: "img", "aria-hidden": true %>
  </div>
  <div class="card--list__text">
    <span class="card--list__heading">
      <%= stripped_translated_attribute activity.description %>
    </span>
    <span class="card--list__meta">
      <% if activity.start_date.present? %>
        <%= t("activemodel.attributes.activity.start_date") %> <%= l(activity.start_date, format: :short) %>
      <% end %>
      <% if activity.end_date.present? %>
        &nbsp;&bull;&nbsp;
        <%= t("activemodel.attributes.activity.end_date") %> <%= l(activity.end_date, format: :short) %>
      <% end %>
      &nbsp;&bull;&nbsp;
      <span class="activity-status activity-status--<%= activity.status %>">
        <%= t("decidim.time_tracker.models.activity.fields.statuses.#{activity.status}") %>
      </span>
    </span>

    <% if activity.respond_to?(:progress) && activity.progress.present? %>
      <div class="activity-progress" style="margin-top: 1rem;">
        <div class="progress" role="progressbar" aria-valuenow="<%= activity.progress %>" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-meter" style="width: <%= activity.progress %>%"></div>
        </div>
        <span class="activity-progress__label"><%= activity.progress %>% <%= t("decidim.time_tracker.activity.completion") %></span>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <div class="card--list__actions pt-2">
        <% if activity.status != :open %>
          <%= render partial: "callout_status", locals: { activity: activity } %>
        <% else %>
          <% if must_fill_in_data? %>
            <div class="callout warning"><%= raw t ".assignee_questionnaire", path: assignee_questionnaire_path %></div>
          <% elsif activity.assignation_pending? current_user %>
            <div class="callout warning"><%= t ".assignation_pending" %></div>
          <% elsif activity.assignation_rejected? current_user %>
            <div class="callout alert"><%= t ".assignation_rejected" %></div>
          <% else %>
            <%= button_to requests_path(activity), method: :create, remote: true, data: { activity_id: activity.id }, class: "button button__sm button__secondary" do %>
              <%= t("index.request", scope: "decidim.components.time_tracker.views") %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
