<div class="time-tracker-activity" id="activity-<%= activity.id %>"
  data-activity-id="<%= activity.id %>"
  data-start-endpoint="<%= start_endpoint(activity) %>"
  data-stop-endpoint="<%= stop_endpoint(activity) %>"
  data-text-counter-stopped="<%= t ".counter_stopped" %>"
  data-elapsed-time="<%= activity.user_seconds_elapsed(current_user) %>"
  data-counter-active="<%= activity.counter_active_for?(current_user) %>"
  data-remaining-time="<%= activity.user_remaining_for_today(current_user) %>">
  <div class="content">
    <% if activity.image.attached? %>
      <img src="<%= activity.attached_uploader(:image).variant_url(:card) %>"
           alt="<%= stripped_translated_attribute activity.description %>"
           class="time-tracker-activity__image rounded mb-4 w-full object-cover" loading="lazy">
    <% end %>

    <div class="activity-status-container">
      <span class="activity-status-badge <%= activity.display_status %>">
        <%= t(".status.#{activity.display_status}") %>
      </span>
      <% if activity.respond_to?(:progress) && activity.progress.present? %>
        <div class="activity-progress">
          <div class="progress" role="progressbar" aria-valuenow="<%= activity.progress %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-meter" style="width: <%= activity.progress %>%"></div>
          </div>
          <span class="activity-progress__label"><%= number_to_percentage(activity.progress, precision: 0) %> <%= t(".completion") %></span>
        </div>
      <% end %>
    </div>

    <h4 class="h4 pb-1"><%= stripped_translated_attribute activity.description %></h4>
    <%= render partial: "activity_participants", locals: { activity: activity } %>
    <span><%= t("activity.info", scope: "decidim.components.time_tracker.views") %></span>
    <div class="elapsed-time pt-2"><%= t("activity.time_elapsed", scope: "decidim.components.time_tracker.views") %> <div class="elapsed-time-clock pt-2"><%= clockify_seconds(activity.user_seconds_elapsed(current_user)) %></div></div>

    <% assignation = activity.assignations.accepted.find_by(user: current_user) %>
    <% if assignation %>
      <% verified = assignation.verified_completions_count %>
      <% pending_completions = assignation.pending_completions.count %>
      <% if verified.positive? || pending_completions.positive? %>
        <div class="time-tracker--completions pt-2">
          <% if verified.positive? %>
            <span class="label success"><%= t("activity.completions.verified", scope: "decidim.time_tracker.time_tracker", count: verified) %></span>
          <% end %>
          <% if pending_completions.positive? %>
            <span class="label warning"><%= t("activity.completions.awaiting_verification", scope: "decidim.time_tracker.time_tracker") %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <div class="top pt-2">
      <% if activity.status != :open %>
        <%= render partial: "callout_status", locals: { activity: activity } %>
      <% else %>
        <div class="tracker-buttons">
          <button class="danger button__lg time-tracker-activity-stop hidden">
            <img src="<%= asset_pack_path("media/images/stop_icon.svg") %>" alt="Stop">
          </button>
          <button class="secondary button__lg time-tracker-activity-pause hidden">
            <img src="<%= asset_pack_path("media/images/pause_icon.svg") %>" alt="Pause">
          </button>
          <button class="success button__lg time-tracker-activity-start">
            <img src="<%= asset_pack_path("media/images/play_icon.svg") %>" alt="Play">
          </button>
        </div>
      <% end %>
    </div>
    <div class="bottom">
      <% if activity.allow_answers_for?(current_user) %>
        <%= render partial: "answer_questionnaire", locals: { activity: activity } %>
      <% end %>
    </div>
  </div>
  <div class="callout alert hidden"></div>

  <%= render partial: "milestone_form", locals: { activity: activity } %>
</div>
