<%= render partial: "decidim/shared/component_announcement" %>

<% content_for :aside do %>
  <%= render partial: "aside" %>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_two_col" do %>
  <% if task_list.empty? %>
    <section class="layout-main__section">
      <%= cell("decidim/announcement", t("decidim.time_tracker.time_tracker.index.empty")) %>
    </section>
  <% else %>
    <% if !user_signed_in? %>
      <section class="layout-main__section">
        <%= render partial: "sign_in" %>
      </section>
    <% elsif must_fill_in_data? %>
      <section class="layout-main__section">
        <%= render partial: "assignee_data" %>
      </section>
    <% end %>

    <%# The activities a volunteer has been accepted onto come first, with their
        timers: tracking time is what they come back to this page to do. %>
    <% if task_list.accepted_activities.any? %>
      <section class="layout-main__section time-tracker__mine" id="my-activities" aria-labelledby="my-activities-title">
        <h2 class="h3 decorator" id="my-activities-title"><%= t("decidim.time_tracker.time_tracker.index.mine.title") %></h2>
        <p class="time-tracker__lead"><%= t("decidim.time_tracker.time_tracker.index.mine.intro") %></p>

        <div class="time-tracker__timers">
          <% task_list.accepted_activities.each do |activity| %>
            <%= render partial: "activity", locals: { activity: } %>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="layout-main__section" id="tasks" aria-labelledby="tasks-title">
      <h2 class="h3 decorator" id="tasks-title"><%= t("decidim.time_tracker.time_tracker.index.all.title") %></h2>

      <div class="time-tracker__tasks">
        <% task_list.tasks.each do |task| %>
          <%= render partial: "task", locals: { task: } %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>

<%= append_stylesheet_pack_tag "decidim_time_tracker" %>
<%= append_javascript_pack_tag "decidim_time_tracker" %>
