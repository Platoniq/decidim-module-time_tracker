<%= render partial: "decidim/shared/component_announcement" %>

<section id="sub_hero" class="home__section">
  <div id="time_tracker" class="columns">
    <% if activities_empty? %>
      <div class="callout warning">
        <%= t(".empty") %>
      </div>
    <% else %>
      <% if !user_signed_in? %>
        <%= render partial: "sign_in" %>
      <% elsif must_fill_in_data? %>
        <%= render partial: "assignee_data" %>
      <% end %>

      <div id="tasks">
        <% tasks.each do |task| %>
          <% active_activities = task.activities.active %>
          <% next if active_activities.empty? %>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="md:col-span-2">
              <h2 class="h2 decorator text-primary"><%= stripped_translated_attribute task.name %></h2>

              <div class="task-results-count">
                <span class="task-results-count__number"><%= active_activities.count %></span>
                <span class="task-results-count__label"><%= t("decidim.participatory_processes.statistics.activities_count").upcase %></span>
              </div>

              <div id="activities" class="card--list">
                <% active_activities.each do |activity| %>
                  <% if activity.assignation_accepted? current_user %>
                    <%= render partial: "activity", locals: { activity: activity } %>
                  <% elsif allowed_to? :create, :assignation, activity: activity %>
                    <%= render partial: "request_activity", locals: { activity: activity } %>
                  <% else %>
                    <%= render partial: "idle_activity", locals: { activity: activity } %>
                  <% end %>

                  <% milestones_for_activity = assignation_milestones(activity) %>
                  <% if milestones_for_activity.any? %>
                    <div class="card--list__item milestones-section">
                      <div class="milestone-link" data-toggle="milestones-collection-<%= activity.id %>">
                        <%= icon "arrow-right-s-line", class: "icon--small" %>
                        <span class="show-milestones">
                          <%= t(".milestones_list") %>
                        </span>
                      </div>

                      <div id="milestones-collection-<%= activity.id %>" data-toggler=".hidden" class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-12 pt-6 hidden" hidden>
                        <% milestones_for_activity.each do |milestone| %>
                          <%= card_for milestone, type: :list %>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>

            <div class="md:col-span-1 mt-6 md:mt-0">
              <% if task&.respond_to?(:progress) && task&.progress.present? %>
                <div class="bg-white border border-gray-200 p-6 rounded shadow-sm">
                  <div class="flex justify-between items-end mb-4">
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider"><%= t(".global_execution") %>:</span>
                    <span class="text-3xl font-bold text-gray-900 leading-none"><%= task.progress %>%</span>
                  </div>
                  <div class="w-full bg-gray-200 h-2 rounded-full overflow-hidden">
                    <div class="bg-red-500 h-2 rounded-full" style="width: <%= task.progress %>%"></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%= append_javascript_pack_tag "decidim_time_tracker" %>
