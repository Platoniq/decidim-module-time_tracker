<h1 class="title-decorator"><%= component_name %></h1>

<% if global_progress.present? %>
  <div class="time-tracker__status time-tracker__status--home">
    <p class="time-tracker__status-title"><%= t("decidim.time_tracker.time_tracker.index.global_execution_status") %></p>

    <div class="time-tracker__status-progress"
         role="progressbar"
         aria-label="<%= t("decidim.time_tracker.time_tracker.index.global_execution_status") %>"
         aria-valuenow="<%= global_progress %>"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuetext="<%= number_to_percentage(global_progress, precision: 0) %>">
      <div style="width: <%= global_progress %>%"></div>
    </div>

    <div class="time-tracker__status-value">
      <span><%= number_to_percentage(global_progress, precision: 0) %></span>
    </div>
  </div>
<% end %>

<% unless task_list.empty? %>
  <dl class="time-tracker__stats">
    <div class="time-tracker__stat">
      <dt><%= icon "list-check" %> <%= t("decidim.time_tracker.time_tracker.aside.activities") %></dt>
      <dd><%= task_list.activities.size %></dd>
    </div>
    <div class="time-tracker__stat">
      <dt><%= icon "group-line" %> <%= t("decidim.time_tracker.time_tracker.aside.volunteers") %></dt>
      <dd><%= task_list.volunteers_count %></dd>
    </div>
    <div class="time-tracker__stat">
      <dt><%= icon "timer-line" %> <%= t("decidim.time_tracker.time_tracker.aside.hours") %></dt>
      <dd><%= number_with_delimiter((task_list.tracked_seconds / 3600.0).round) %></dd>
    </div>
  </dl>
<% end %>

<div class="time-tracker__aside-links">
  <% if user_signed_in? %>
    <%= link_to user_report_path, class: "button button__sm button__secondary w-full" do %>
      <%= icon "user-star-line" %> <%= t("decidim.time_tracker.time_tracker.aside.my_progress_and_skills") %>
    <% end %>
  <% end %>
  <%= link_to decidim.public_badges_path, class: "button button__sm button__transparent-secondary w-full" do %>
    <%= icon "award-line" %> <%= t("decidim.time_tracker.time_tracker.aside.how_it_works") %>
  <% end %>
</div>
