<% content_for :aside do %>
  <%= render partial: "decidim/time_tracker/time_tracker/aside" %>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_two_col" do %>
  <%= link_to t("decidim.time_tracker.time_tracker.index.back_to_tasks", default: "Back to tasks"), root_path, class: "button button__sm button__secondary mb-4" %>
  <section class="section">
    <h3 class="h3"><%= t("reports.user.index.skills_title", scope: "decidim.time_tracker") %></h3>
    <% if skill_certifications.any? %>
      <div class="card__list-list pt-2 pb-8">
        <% skill_certifications.each do |certification| %>
          <div class="card__list time-tracker--skill">
            <div class="card--list__item">
              <div class="card--list__text">
                <h5 class="h5 pb-2">
                  <%= translated_attribute(certification.skill_name) %>
                </h5>
                <ul class="text-sm pb-2 pl-4" style="list-style-type: disc;">
                  <% certification.task.activities.active.each do |activity| %>
                    <% assignation = activity.assignations.find_by(user: current_user) %>
                    <li>
                      <% if assignation %>
                        <%= link_to activity_path(assignation), target: :blank, class: "hover:underline" do %>
                          <%= translated_attribute(activity.description) %>
                          <span class="text-muted">(<%= clockify_seconds(assignation.time_dedicated) %>)</span>
                        <% end %>
                      <% else %>
                        <%= translated_attribute(activity.description) %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
                <span class="text-xs text-muted">
                  <%= t("reports.user.index.earned_on", scope: "decidim.time_tracker", date: l(certification.earned_at, format: :decidim_short)) %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="pt-2 pb-8"><%= t("reports.user.index.skills_empty", scope: "decidim.time_tracker") %></p>
    <% end %>
  </section>

  <section class="section">
    <% if assignations.any? %>

      <h3 class="h3"><%== t("reports.user.index.dedicated_time", scope: "decidim.time_tracker", time: clockify_seconds(total_time)) %></h3>
      <div class="card__list-list pt-8">
        <% assignations.each do |assignation| %>
          <%= link_to activity_path(assignation), class: "card__list time-tracker--activity", target: :blank do %>
            <div class="card--list__item">
              <div class="card--list__text">
                <div>
                  <h5 class="h5 pb-2">
                    <%= translated_attribute(assignation.activity.description) %>
                  </h5>
                  <span class="text-xs">
                    <%= assignation_status_label assignation.status %>
                    <span class="assignation--date"><%= assignation_date(assignation) %></span>
                  </span>
                </div>
              </div>
              <div class="card--list__annotation">
                <%= clockify_seconds assignation.time_dedicated, padded: true %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card--list__item">
        <div class="card--list__text">
          <%= t("empty", scope: "decidim.time_tracker.reports.user.index") %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<%= append_javascript_pack_tag "decidim_time_tracker" %>
