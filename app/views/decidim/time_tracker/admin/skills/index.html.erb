<%= render partial: "decidim/time_tracker/admin/navigation" %>

<% add_decidim_page_title(t("decidim.time_tracker.admin.skills.index.page_title")) %>
<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("decidim.time_tracker.admin.skills.index.page_title") %>
    <%= link_to t("decidim.time_tracker.admin.skills.index.public_page"), decidim.public_badges_path, class: "button button__sm button__transparent-secondary", target: "_blank", rel: "noopener" %>
  </h1>
</div>

<div class="time-tracker-admin__intro">
  <p><%= t("decidim.time_tracker.admin.skills.index.intro") %></p>
  <ol>
    <li><%= t("decidim.time_tracker.admin.skills.index.steps.skills") %></li>
    <li><%= t("decidim.time_tracker.admin.skills.index.steps.verify") %></li>
    <li><%= t("decidim.time_tracker.admin.skills.index.steps.badges") %></li>
  </ol>
  <% unless allowed_to? :create, :skill %>
    <p class="time-tracker-admin__notice"><%= icon "lock-line" %> <%= t(".organization_admins_only") %></p>
  <% end %>
</div>

<div class="card time-tracker-admin__panel" id="skills">
  <div class="item_show__header">
    <h2 class="item_show__header-title">
      <%= t(".title") %>
      <% if allowed_to? :create, :skill %>
        <%= link_to new_skill_path, class: "button button__sm button__secondary" do %>
          <%= icon "add-line" %> <%= t("skills.actions.new", scope: "decidim.time_tracker.admin") %>
        <% end %>
      <% end %>
    </h2>
  </div>

  <div class="card-section">
    <p class="help-text"><%= t(".description") %></p>

    <% if skills.any? %>
      <div class="table-scroll">
        <table class="table-list time-tracker-admin__table">
          <thead>
            <tr>
              <th><%= t("models.skill.fields.name", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.skill.fields.earning_mode", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.skill.fields.tasks_count", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.skill.fields.certified", scope: "decidim.time_tracker") %></th>
              <th class="actions"><%= t("actions.title", scope: "decidim.time_tracker.admin") %></th>
            </tr>
          </thead>
          <tbody>
            <% skills.each do |skill| %>
              <% task_names = skill.tasks.map { |task| translated_attribute(task.name) } %>
              <tr>
                <td>
                  <strong><%= translated_attribute(skill.name) %></strong>
                  <% if skill.description.present? && translated_attribute(skill.description).present? %>
                    <span class="time-tracker-admin__muted"><%= translated_attribute(skill.description) %></span>
                  <% end %>
                </td>
                <td><%= skill_rule_sentence(skill) %></td>
                <td title="<%= task_names.to_sentence %>">
                  <% if task_names.any? %>
                    <%= task_names.first(2).join(", ") %><%= t("decidim.time_tracker.admin.skills.index.more_tasks", count: task_names.size - 2) if task_names.size > 2 %>
                  <% else %>
                    <span class="time-tracker-admin__warning"><%= t(".no_tasks") %></span>
                  <% end %>
                </td>
                <td><%= certified_counts.fetch(skill.id, 0) %></td>
                <td class="table-list__actions">
                  <% if allowed_to? :update, :skill, skill: skill %>
                    <%= icon_link_to "pencil-line", edit_skill_path(skill), t("skills.actions.edit", scope: "decidim.time_tracker.admin"), class: "action-icon--edit" %>
                  <% end %>
                  <% if allowed_to? :destroy, :skill, skill: skill %>
                    <%= icon_link_to "close-circle-line", skill_path(skill), t("skills.actions.destroy", scope: "decidim.time_tracker.admin"), method: :delete, class: "action-icon--remove", data: { confirm: t("skills.actions.confirm_destroy", scope: "decidim.time_tracker.admin") } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p><%= t(".empty") %></p>
    <% end %>
  </div>
</div>

<%= render partial: "decidim/time_tracker/admin/badges/table" %>
