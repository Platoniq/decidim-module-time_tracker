<%= render partial: "decidim/time_tracker/admin/breadcrumbs" %>

<div class="card pt-8">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <%= link_to t("skills.actions.new", scope: "decidim.time_tracker.admin"), new_skill_path, class: "button button__sm button__secondary" %>
    </h1>
  </div>

  <div class="card-section">
    <p class="text-sm text-muted pb-4"><%= t(".description") %></p>

    <% if skills.any? %>
      <div class="table-scroll">
        <table class="table-list">
          <thead>
            <tr>
              <th><%= t("models.skill.fields.name", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.skill.fields.description", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.skill.fields.earning_mode", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.skill.fields.tasks_count", scope: "decidim.time_tracker") %></th>
              <th class="actions"><%= t("actions.title", scope: "decidim.time_tracker.admin") %></th>
            </tr>
          </thead>
          <tbody>
            <% skills.each do |skill| %>
              <tr>
                <td><%= translated_attribute(skill.name) %></td>
                <td><%= translated_attribute(skill.description) %></td>
                <td>
                  <% if skill.time_spent? %>
                    <%= t("models.skill.earning_summary.time_spent", scope: "decidim.time_tracker", hours: (skill.required_minutes.to_i / 60.0).round(1)) %>
                  <% else %>
                    <%= t("models.skill.earning_summary.completed_activities", scope: "decidim.time_tracker",
                          activities: skill.required_activities_count || t("models.skill.earning_summary.all_activities", scope: "decidim.time_tracker"),
                          times: skill.required_completions_per_activity) %>
                  <% end %>
                </td>
                <td><%= skill.tasks.count %></td>
                <td class="table-list__actions">
                  <% if allowed_to? :update, :skill, skill: skill %>
                    <%= icon_link_to "pencil-line", edit_skill_path(skill), t("skills.actions.edit", scope: "decidim.time_tracker.admin"), class: "action-icon--edit" %>
                  <% end %>

                  <% if allowed_to? :destroy, :skill, skill: skill %>
                    <%= icon_link_to "close-circle-line", skill_path(skill), t("skills.actions.destroy", scope: "decidim.time_tracker.admin"), method: :delete, class: "action-icon--remove", data: { confirm: t("skills.actions.confirm_destroy", scope: "decidim.time_tracker.admin") } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p><%= t(".empty") %></p>
    <% end %>
  </div>
</div>

<%= render partial: "decidim/time_tracker/admin/badges/table" %>
