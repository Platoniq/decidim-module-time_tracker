<%# A skill in three steps: what it is, which tasks can earn it, and the rule
    a volunteer's work has to meet. Only the numbers the chosen rule uses are
    shown, and the sentence under them restates the rule as it is edited. %>
<div class="form__wrapper time-tracker-admin__form" id="skill-rules" data-strings="<%= skill_rule_strings_json %>">
  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.skills.form.sections.about") %></h2>
      <div class="row column">
        <%= form.translated :text_field, :name, autofocus: true %>
        <p class="help-text"><%= t("skills.form.name_help", scope: "decidim.time_tracker.admin") %></p>
      </div>
      <div class="row column">
        <%= form.translated :text_field, :description %>
      </div>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.skills.form.sections.tasks") %></h2>
      <p class="help-text"><%= t("skills.form.tasks_help", scope: "decidim.time_tracker.admin") %></p>
      <%= render partial: "decidim/time_tracker/admin/shared/task_checkboxes", locals: { form:, attribute: :task_ids } %>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.skills.form.sections.rule") %></h2>

      <div class="time-tracker-admin__choices time-tracker-admin__choices--two" role="radiogroup" aria-label="<%= t("activemodel.attributes.skill.earning_mode") %>">
        <% { "completed_activities" => "check-double-line", "time_spent" => "timer-line" }.each do |mode, icon_name| %>
          <label class="time-tracker-admin__choice">
            <%= radio_button_tag "skill[earning_mode]", mode, form.object.earning_mode == mode, id: "skill_earning_mode_#{mode}" %>
            <span class="time-tracker-admin__choice-icon" aria-hidden="true"><%= icon icon_name %></span>
            <span class="time-tracker-admin__choice-text">
              <strong><%= t("decidim.time_tracker.models.skill.earning_modes.#{mode}") %></strong>
              <span><%= t("decidim.time_tracker.admin.skills.form.mode_explanations.#{mode}") %></span>
            </span>
          </label>
        <% end %>
      </div>

      <div class="time-tracker-admin__numbers">
        <div id="skill-required-activities">
          <%= form.number_field :required_activities_count, min: 1 %>
          <p class="help-text"><%= t("skills.form.required_activities_help", scope: "decidim.time_tracker.admin") %></p>
        </div>

        <div id="skill-required-completions">
          <%= form.number_field :required_completions_per_activity, min: 1 %>
          <p class="help-text"><%= t("skills.form.required_completions_help", scope: "decidim.time_tracker.admin") %></p>
        </div>

        <div id="skill-required-hours">
          <%= form.number_field :required_hours, min: 0, step: 0.5 %>
          <p class="help-text"><%= t("skills.form.required_hours_help", scope: "decidim.time_tracker.admin") %></p>
        </div>
      </div>
    </div>
  </section>

  <div class="admin-rule-preview" aria-live="polite">
    <span class="admin-rule-preview__label"><%= t("skills.form.preview_label", scope: "decidim.time_tracker.admin") %></span>
    <span class="admin-rule-preview__text" id="skill-rule-preview"></span>
  </div>
</div>
