<%# The badge's rule is set in four steps, each in its own section; the
    sentence under them restates what the badge will say as it is edited. %>
<div class="form__wrapper time-tracker-admin__form" id="badge-levels"
     data-default-curves="<%= form.object.default_curves.to_json %>"
     data-metric-units="<%= badge_metric_units_json %>"
     data-metric-labels="<%= badge_metric_labels_json %>"
     data-preview-templates="<%= badge_preview_templates_json %>">

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.badges.form.sections.about") %></h2>
      <div class="row column">
        <%= form.translated :text_field, :name, autofocus: true %>
      </div>
      <div class="row column">
        <%= form.translated :text_field, :description %>
        <p class="help-text"><%= t("decidim.time_tracker.admin.badges.form.description_help") %></p>
      </div>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.badges.form.sections.counts") %></h2>

      <div class="time-tracker-admin__choices" role="radiogroup" aria-label="<%= t("activemodel.attributes.badge.metric") %>">
        <% Decidim::TimeTracker::Badge::METRICS.each do |metric| %>
          <label class="time-tracker-admin__choice">
            <%= radio_button_tag "badge[metric]", metric, form.object.metric == metric, id: "badge_metric_#{metric}" %>
            <span class="time-tracker-admin__choice-icon" aria-hidden="true"><%= icon Decidim::TimeTracker::Badge::METRIC_ICONS[metric] %></span>
            <span class="time-tracker-admin__choice-text">
              <strong><%= t("decidim.time_tracker.models.badge.metrics.#{metric}") %></strong>
              <span><%= t("decidim.time_tracker.admin.badges.form.metric_explanations.#{metric}") %></span>
            </span>
          </label>
        <% end %>
      </div>
      <% if form.object.errors[:metric].any? %>
        <small class="form-error is-visible"><%= form.object.errors[:metric].to_sentence %></small>
      <% end %>

      <div class="time-tracker-admin__subsection" id="badge-skills-field">
        <h3 class="time-tracker-admin__subsection-title"><%= t("activemodel.attributes.badge.skill_ids") %></h3>
        <p class="help-text"><%= t("decidim.time_tracker.admin.badges.form.skills_help") %></p>
        <div class="time-tracker-admin__checks">
          <% form.object.available_skills.each do |skill| %>
            <label class="time-tracker-admin__check">
              <%= check_box_tag "badge[skill_ids][]", skill.id, Array(form.object.skill_ids).include?(skill.id),
                                id: "badge_skill_ids_#{skill.id}", data: { label: translated_attribute(skill.name) } %>
              <span><%= translated_attribute(skill.name) %></span>
            </label>
          <% end %>
        </div>
        <% if form.object.errors[:skill_ids].any? %>
          <small class="form-error is-visible"><%= form.object.errors[:skill_ids].to_sentence %></small>
        <% end %>
      </div>

      <div class="time-tracker-admin__subsection" id="badge-tasks-field">
        <h3 class="time-tracker-admin__subsection-title"><%= t("decidim.time_tracker.admin.badges.form.which_work") %></h3>
        <% restricted = Array(form.object.task_ids).compact.any? %>
        <div class="time-tracker-admin__inline-choices">
          <label><%= radio_button_tag "badge_task_scope", "all", !restricted, id: "badge_task_scope_all" %> <%= t("decidim.time_tracker.admin.badges.form.every_task") %></label>
          <label><%= radio_button_tag "badge_task_scope", "some", restricted, id: "badge_task_scope_some" %> <%= t("decidim.time_tracker.admin.badges.form.some_tasks") %></label>
        </div>
        <div id="badge-task-list"<%= " hidden" unless restricted %>>
          <%= render partial: "decidim/time_tracker/admin/shared/task_checkboxes", locals: { form:, attribute: :task_ids } %>
        </div>
      </div>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.badges.form.sections.levels") %></h2>
      <div class="row column">
        <% level_options = (1..Decidim::TimeTracker::Badge::MAX_LEVELS).map { |count| [t("badges.form.levels_count_option", scope: "decidim.time_tracker.admin", count: count), count] } %>
        <%= form.select :levels_count, level_options %>
        <p class="help-text"><%= t("badges.form.levels_count_help", scope: "decidim.time_tracker.admin") %></p>
      </div>

      <div id="badge-level-thresholds">
        <p class="help-text"><%= t("badges.form.thresholds_help", scope: "decidim.time_tracker.admin") %></p>

        <%# Rows past the chosen count are rendered hidden and disabled rather
            than left to the script, so the form does not flash all ten rows on
            load and still submits the right thresholds without JavaScript. %>
        <% current_levels = form.object.levels %>
        <% chosen_count = current_levels.size %>
        <%# Guarded: a blank metric would make this key resolve to the parent
            "units" node, printing the whole hash next to every level. %>
        <% unit = badge_metric_unit(form.object.metric) %>
        <% (1..Decidim::TimeTracker::Badge::MAX_LEVELS).each do |level| %>
          <% beyond_count = level > chosen_count %>
          <%# `hidden` is a boolean attribute — the tag helper drops it when
              false, where hidden="false" would still hide the row. %>
          <%= tag.div class: "badge-level-row", data: { level: }, hidden: beyond_count do %>
            <label for="badge_level_thresholds_<%= level %>">
              <%= t("badges.form.level_reached_at", scope: "decidim.time_tracker.admin", level: level) %>
            </label>
            <div class="badge-level-row__input">
              <%= number_field_tag "badge[level_thresholds][]",
                                   current_levels[level - 1],
                                   id: "badge_level_thresholds_#{level}",
                                   min: 1,
                                   disabled: beyond_count,
                                   class: "badge-level-threshold" %>
              <span class="badge-level-row__unit"><%= unit %></span>
            </div>
          <% end %>
        <% end %>
        <% if form.object.errors[:level_thresholds].any? %>
          <small class="form-error is-visible"><%= form.object.errors[:level_thresholds].to_sentence %></small>
        <% end %>
      </div>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.badges.form.sections.publish") %></h2>
      <div class="row column">
        <%= form.check_box :active %>
        <p class="help-text"><%= t("decidim.time_tracker.admin.badges.form.active_help") %></p>
      </div>
      <div class="row column">
        <%= form.number_field :weight, min: 0 %>
        <p class="help-text"><%= t("decidim.time_tracker.admin.badges.form.weight_help") %></p>
      </div>
    </div>
  </section>

  <div class="admin-rule-preview" aria-live="polite">
    <span class="admin-rule-preview__label"><%= t("badges.form.preview_label", scope: "decidim.time_tracker.admin") %></span>
    <span class="admin-rule-preview__text" id="badge-rule-preview"></span>
  </div>
</div>
