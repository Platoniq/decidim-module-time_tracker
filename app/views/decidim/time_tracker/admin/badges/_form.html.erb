<div class="form__wrapper">
  <div class="card pt-4">
    <div class="card-section">
      <div class="item_show__header">
        <h1 class="item_show__header-title">
          <%= title %>
        </h1>
      </div>

      <div class="row column">
        <%= form.translated :text_field, :name, autofocus: true %>
      </div>

      <div class="row column">
        <%= form.translated :text_field, :description %>
      </div>

      <div class="row column">
        <% metric_options = Decidim::TimeTracker::Badge::METRICS.map { |metric| [t("models.badge.metrics.#{metric}", scope: "decidim.time_tracker"), metric] } %>
        <%= form.select :metric, metric_options %>
        <p class="help-text"><%= t("badges.form.metric_help", scope: "decidim.time_tracker.admin") %></p>
      </div>

      <%# The thresholds are prefilled from the metric's default curve by the
          admin script, so picking a number of levels is enough on its own. %>
      <div class="row column" id="badge-levels"
           data-default-curves="<%= form.object.default_curves.to_json %>"
           data-metric-units="<%= Decidim::TimeTracker::Badge::METRICS.index_with { |metric| t("badges.form.units.#{metric}", scope: "decidim.time_tracker.admin") }.to_json %>">
        <% level_options = (1..Decidim::TimeTracker::Badge::MAX_LEVELS).map { |count| [t("badges.form.levels_count_option", scope: "decidim.time_tracker.admin", count: count), count] } %>
        <%= form.select :levels_count, level_options %>
        <p class="help-text"><%= t("badges.form.levels_count_help", scope: "decidim.time_tracker.admin") %></p>

        <div class="card-section pt-2" id="badge-level-thresholds">
          <p class="help-text pb-2"><%= t("badges.form.thresholds_help", scope: "decidim.time_tracker.admin") %></p>

          <%# Rows past the chosen count are rendered hidden and disabled rather
              than left to the script, so the form does not flash all ten rows on
              load and still submits the right thresholds without JavaScript. %>
          <% current_levels = form.object.levels %>
          <% chosen_count = current_levels.size %>
          <% unit = t("badges.form.units.#{form.object.metric}", scope: "decidim.time_tracker.admin", default: "") %>
          <% (1..Decidim::TimeTracker::Badge::MAX_LEVELS).each do |level| %>
            <% beyond_count = level > chosen_count %>
            <%# `hidden` is a boolean attribute — the tag helper drops it when
                false, where hidden="false" would still hide the row. %>
            <%= tag.div class: "badge-level-row", data: { level: }, hidden: beyond_count do %>
              <label for="badge_level_thresholds_<%= level %>">
                <%= t("badges.form.level_reached_at", scope: "decidim.time_tracker.admin", level: level) %>
              </label>
              <div class="badge-level-row__input">
                <%= number_field_tag "badge[level_thresholds][]",
                                     current_levels[level - 1],
                                     id: "badge_level_thresholds_#{level}",
                                     min: 1,
                                     disabled: beyond_count,
                                     class: "badge-level-threshold" %>
                <span class="badge-level-row__unit"><%= unit %></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="row column">
        <% skill_options = form.object.available_skills.map { |skill| [translated_attribute(skill.name), skill.id] } %>
        <%= form.select :skill_ids,
                        options_for_select(skill_options, form.object.skill_ids),
                        { include_hidden: false },
                        multiple: true %>
        <p class="help-text"><%= t("badges.form.skills_help", scope: "decidim.time_tracker.admin") %></p>
      </div>

      <div class="row column">
        <%= form.select :task_ids,
                        grouped_options_for_select(form.object.grouped_task_options, form.object.task_ids),
                        { include_hidden: false },
                        multiple: true %>
        <p class="help-text"><%= t("badges.form.tasks_help", scope: "decidim.time_tracker.admin") %></p>
      </div>

      <div class="row column">
        <%= form.number_field :weight %>
      </div>

      <div class="row column">
        <%= form.check_box :active %>
      </div>

      <div class="button button__sm button__secondary pt-4">
        <%= form.submit submit %>
      </div>
    </div>
  </div>
</div>
