<%= render partial: "decidim/time_tracker/admin/breadcrumbs" %>

<div class="card pt-8">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <%= link_to t("badges.actions.new", scope: "decidim.time_tracker.admin"), new_badge_path, class: "button button__sm button__secondary" %>
    </h1>
  </div>

  <div class="card-section">
    <p class="text-sm text-muted pb-4"><%= t(".description") %></p>

    <% if badges.any? %>
      <div class="table-scroll">
        <table class="table-list">
          <thead>
            <tr>
              <th><%= t("models.badge.fields.name", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.badge.fields.metric", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.badge.fields.levels", scope: "decidim.time_tracker") %></th>
              <th><%= t("models.badge.fields.active", scope: "decidim.time_tracker") %></th>
              <th class="actions"><%= t("actions.title", scope: "decidim.time_tracker.admin") %></th>
            </tr>
          </thead>
          <tbody>
            <% badges.each do |badge| %>
              <tr>
                <td><%= translated_attribute(badge.name) %></td>
                <td><%= t("models.badge.metrics.#{badge.metric}", scope: "decidim.time_tracker") %></td>
                <td><%= badge.levels.join(", ") %></td>
                <td><%= badge.active? ? "✓" : "✗" %></td>
                <td class="table-list__actions">
                  <% if allowed_to? :update, :time_tracker_badge, badge: badge %>
                    <%= icon_link_to "pencil-line", edit_badge_path(badge), t("badges.actions.edit", scope: "decidim.time_tracker.admin"), class: "action-icon--edit" %>
                  <% end %>

                  <% if allowed_to? :destroy, :time_tracker_badge, badge: badge %>
                    <%= icon_link_to "close-circle-line", badge_path(badge), t("badges.actions.destroy", scope: "decidim.time_tracker.admin"), method: :delete, class: "action-icon--remove", data: { confirm: t("badges.actions.confirm_destroy", scope: "decidim.time_tracker.admin") } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p><%= t(".empty") %></p>
    <% end %>
  </div>
</div>
