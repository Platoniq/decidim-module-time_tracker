<div class="form__wrapper time-tracker-admin__form">
  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.activities.form.sections.about") %></h2>
      <div class="row column">
        <%= form.translated :text_field, :description, autofocus: true %>
      </div>
      <div class="row column">
        <%= form.upload :image, button_class: "button button__sm button__transparent-secondary" %>
        <p class="help-text"><%= t("decidim.time_tracker.admin.activities.form.image_help") %></p>
      </div>
      <div class="row column">
        <%= form.number_field :progress, step: 1, min: 0, max: 100 %>
        <p class="help-text"><%= t("decidim.time_tracker.admin.activities.form.progress_help") %></p>
      </div>
      <div class="row column">
        <%= form.check_box :active %>
      </div>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.activities.form.sections.dates") %></h2>
      <div class="time-tracker-admin__numbers">
        <div><%= form.datetime_field :start_date %></div>
        <div><%= form.datetime_field :end_date %></div>
      </div>
      <div class="row column pt-4">
        <%= form.datetime_field :requests_start_at %>
        <p class="help-text"><%= t("decidim.time_tracker.admin.activities.form.requests_help") %></p>
      </div>
    </div>
  </section>

  <section class="card time-tracker-admin__section">
    <div class="card-section">
      <h2 class="time-tracker-admin__section-title"><%= t("decidim.time_tracker.admin.activities.form.sections.time") %></h2>
      <div class="row column">
        <%= form.number_field :max_minutes_per_day, min: 1 %>
      </div>
      <p class="help-text"><%= t("decidim.time_tracker.admin.activities.form.rule_help") %></p>
      <div class="time-tracker-admin__numbers">
        <div><%= form.number_field :min_events, min: 0 %></div>
        <div><%= form.number_field :min_duration_minutes_per_event, min: 0 %></div>
      </div>
    </div>
  </section>
</div>
