<% presented_user = present(user) %>
<% joined_at = user_joined_at(user) %>
<% last_milestone = user_last_milestone(user) %>

<% content_for :aside do %>
  <div class="time-tracker__person">
    <%= image_tag presented_user.avatar_url(:big), alt: "", class: "time-tracker__report-avatar" %>
    <div>
      <p class="h4"><%= link_to presented_user.name, presented_user.profile_path %></p>
      <span class="text-gray-2">@<%= presented_user.nickname %></span>
    </div>
  </div>

  <dl class="time-tracker__stats">
    <div class="time-tracker__stat">
      <dt><%= icon "timer-line" %> <%= t("decidim.time_tracker.milestones.index.total_time") %></dt>
      <dd><%= duration_in_words(user_total_time_dedicated(user)) %></dd>
    </div>
    <div class="time-tracker__stat">
      <dt><%= icon "calendar-line" %> <%= t("decidim.time_tracker.milestones.index.joined_on") %></dt>
      <dd><%= joined_at ? l(joined_at.to_date, format: :decidim_short_with_month_name_short) : "—" %></dd>
    </div>
    <div class="time-tracker__stat">
      <dt><%= icon "history" %> <%= t("decidim.time_tracker.milestones.index.last_worked_on") %></dt>
      <dd><%= last_milestone ? l(last_milestone.created_at.to_date, format: :decidim_short_with_month_name_short) : "—" %></dd>
    </div>
  </dl>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_two_col" do %>
  <section class="layout-main__section">
    <%= link_to root_path, class: "time-tracker__back" do %>
      <%= icon "arrow-left-line" %> <%= t("decidim.time_tracker.milestones.index.back_to_list") %>
    <% end %>
    <h1 class="h2"><%= t("decidim.time_tracker.milestones.index.assignations_activity", user_name: presented_user.name) %></h1>
  </section>

  <% activities.each do |activity| %>
    <section class="layout-main__section time-tracker__report-section">
      <p class="time-tracker__eyebrow"><%= stripped_translated_attribute activity.task.name %></p>
      <h2 class="h4">
        <%= link_to stripped_translated_attribute(activity.description), task_activity_path(activity.task, activity), class: "time-tracker__activity-title" %>
      </h2>
      <div class="time-tracker__milestones">
        <% activity.milestones.where(user:).order(created_at: :desc).each do |milestone| %>
          <%= card_for milestone %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>

<%= append_stylesheet_pack_tag "decidim_time_tracker" %>
