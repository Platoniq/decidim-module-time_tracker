<%# Organisation-level page, outside the component, so the module stylesheet
    is not already on the layout. %>
<%= append_stylesheet_pack_tag "decidim_time_tracker" %>

<%= render layout: "layouts/decidim/shared/layout_user_profile" do %>
  <% add_decidim_page_title(t("time_tracker", scope: "layouts.decidim.user_profile")) %>
  <% content_for(:subtitle) { t("time_tracker", scope: "layouts.decidim.user_profile") } %>

  <div class="time-tracker__report">
    <% if assignations_by_component.any? %>
      <p class="time-tracker__meta time-tracker__report-total">
        <span><%= icon "timer-line" %> <%= t("decidim.time_tracker.reports.total_time", duration: duration_in_words(total_time)) %></span>
      </p>
    <% end %>

    <%= render partial: "decidim/time_tracker/shared/skills_earned", locals: { certifications: skill_certifications } %>

    <%= render partial: "decidim/time_tracker/shared/earned_badges" %>

    <% if assignations_by_component.any? %>
      <% assignations_by_component.each do |component, assignations| %>
        <section class="time-tracker__report-section">
          <div class="time-tracker__report-heading">
            <h2 class="h4">
              <%= translated_attribute(component.participatory_space.title) %> — <%= translated_attribute(component.name) %>
            </h2>
            <%= link_to t("decidim.time_tracker.my_activities.show.component_report"), Decidim::EngineRouter.main_proxy(component).user_report_path %>
          </div>
          <%= render partial: "decidim/time_tracker/shared/assignation_list", locals: { assignations: } %>
        </section>
      <% end %>
    <% else %>
      <p class="time-tracker__empty"><%= t("decidim.time_tracker.my_activities.show.empty") %></p>
    <% end %>

    <% if data_donation %>
      <% scope = "decidim.time_tracker.time_tracker.checkout_survey.donation" %>
      <section class="time-tracker__donated" id="donated-data" aria-labelledby="donated-data-title">
        <h2 class="h4" id="donated-data-title"><%= t("decidim.time_tracker.my_activities.show.donated.title") %></h2>
        <p><%= t("decidim.time_tracker.my_activities.show.donated.intro", date: l(data_donation.consented_at.to_date, format: :long)) %></p>
        <% none = t("decidim.time_tracker.time_tracker.checkout_survey.prefer_not_to_say") %>
        <% genders = data_donation.gender_identities.map { |key| t("gender.#{key}", scope:) } + [data_donation.gender_self_described].compact_blank %>
        <dl class="time-tracker__donated-list">
          <dt><%= t("age_range.label", scope:) %></dt>
          <dd><%= data_donation.age_range.present? ? t("age_range.#{data_donation.age_range}", scope:) : none %></dd>
          <dt><%= t("ethnicity.label", scope:) %></dt>
          <dd><%= data_donation.ethnicity.presence || none %></dd>
          <dt><%= t("gender.label", scope:) %></dt>
          <dd><%= genders.join(", ").presence || none %></dd>
          <dt><%= t("disability.label", scope:) %></dt>
          <dd><%= data_donation.disability.present? ? t("disability.#{data_donation.disability}", scope:) : none %></dd>
          <dt><%= t("migrant_background.label", scope:) %></dt>
          <dd><%= data_donation.migrant_background.present? ? t("migrant_background.#{data_donation.migrant_background}", scope:) : none %></dd>
        </dl>
        <%= button_to t("decidim.time_tracker.my_activities.show.donated.withdraw"),
                      decidim.time_tracker_donated_data_path,
                      method: :delete,
                      class: "button button__sm button__transparent-secondary",
                      data: { confirm: t("decidim.time_tracker.my_activities.show.donated.confirm") } %>
      </section>
    <% end %>
  </div>
<% end %>
